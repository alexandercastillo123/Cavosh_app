<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sh_header_police_blue"
    android:orientation="vertical">

    <!-- Header bar: Flecha atrás y título Elige tu Cafetería -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <ImageButton
            android:id="@+id/btnCafeBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_description"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Elige tu Cafetería"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Contenedor blanco con filtros, pestañas, lista/mapa y botones -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <!-- Opción 1: Elegido frecuentemente -->
            <LinearLayout
                android:id="@+id/rowFrequentlyChosen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Elegido frecuentemente"
                    android:textColor="@color/gunmetal"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbFrequentlyChosen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/carmine_pink"
                    android:checked="true" />
            </LinearLayout>

            <!-- Opción 2: Buscar por ciudad -->
            <LinearLayout
                android:id="@+id/rowSearchByCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Buscar por ciudad"
                    android:textColor="@color/gunmetal"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbSearchByCity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/carmine_pink" />
            </LinearLayout>

            <!-- Input Ciudad -->
            <EditText
                android:id="@+id/etSearchCity"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/sh_edittext_city"
                android:hint="Ciudad"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:paddingHorizontal="16dp"
                android:textColor="@color/gunmetal"
                android:textColorHint="#999999"
                android:textSize="13sp" />

            <!-- Opción 3: Cafeterías cerca de mí -->
            <LinearLayout
                android:id="@+id/rowCafesNearMe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cafeterías cerca de mí"
                    android:textColor="@color/gunmetal"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbCafesNearMe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/carmine_pink" />
            </LinearLayout>

            <!-- Activar ubicación prompt -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Activa la ubicación para ver cafeterías cercanas. "
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTurnOnLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Activar"
                    android:textColor="@color/carmine_pink"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Pestañas Lista / Mapa -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Tab Lista -->
                <LinearLayout
                    android:id="@+id/layoutTabList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tabList"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lista"
                        android:textColor="#888888"
                        android:textSize="15sp" />

                    <View
                        android:id="@+id/tabListIndicator"
                        android:layout_width="32dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/sh_tab_indicator_orange"
                        android:visibility="invisible" />
                </LinearLayout>

                <!-- Tab Mapa -->
                <LinearLayout
                    android:id="@+id/layoutTabMap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tabMap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mapa"
                        android:textColor="@color/carmine_pink"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/tabMapIndicator"
                        android:layout_width="32dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/sh_tab_indicator_orange"
                        android:visibility="visible" />
                </LinearLayout>

            </LinearLayout>

            <!-- Contenedor Mapa / Lista -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="10dp">

                <!-- Lista de Sucursales -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCafes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_sucursal" />

                <!-- Vista de Mapa Interactiva con Pines y Callout -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/flMapView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/sh_map_roads"
                    android:visibility="visible">

                    <!-- Pin de Cafetería naranja -->
                    <ImageView
                        android:id="@+id/ivCafePin"
                        android:layout_width="28dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="44dp"
                        android:layout_marginTop="60dp"
                        android:src="@drawable/ic_map_pin"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Callout / Popup Flotante de Cavosh Cafe -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="6dp"
                        app:layout_constraintBottom_toTopOf="@id/ivCafePin"
                        app:layout_constraintStart_toEndOf="@id/ivCafePin">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="8dp">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/sh_header_police_blue"
                                android:padding="6dp"
                                android:src="@drawable/ic_logo" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Cavosh Cafe"
                                    android:textColor="@color/gunmetal"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Legnicka 5, Wrocław"
                                    android:textColor="#666666"
                                    android:textSize="11sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Abierto: 8:00 AM - 22:00 PM"
                                    android:textColor="#888888"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Pin azul del Usuario -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="48dp"
                        android:layout_marginBottom="28dp"
                        android:src="@drawable/ic_user_pin"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </FrameLayout>

            <!-- Cafetería elegida -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cafetería elegida"
                    android:textColor="@color/gunmetal"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvChosenCafeName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gunmetal"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Legnicka 5, Wrocław" />
            </LinearLayout>

            <!-- Botones Guardar y Cancelar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveCafe"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/gunmetal"
                    android:text="Guardar"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="22dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelCafe"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Cancelar"
                    android:textAllCaps="false"
                    android:textColor="@color/gunmetal"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="22dp"
                    app:strokeColor="@color/gunmetal"
                    app:strokeWidth="1.5dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
