<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sh_header_police_blue"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Header con título ¡Gracias por tu pedido! -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="18dp">

            <TextView
                android:id="@+id/tvSuccessHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡Gracias por tu pedido!"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Contenedor blanco -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="22dp"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">

                <!-- Switch Segmento: Seguimiento vs Detalles del pedido -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/sh_edittext_city"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTabTracking"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:backgroundTint="@color/carmine_pink"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Seguimiento"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="20dp"
                        app:elevation="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTabOrderDetails"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Detalles del pedido"
                        android:textAllCaps="false"
                        android:textColor="@color/gunmetal"
                        android:textSize="13sp"
                        app:cornerRadius="20dp" />
                </LinearLayout>

                <!-- Tarjeta Número de pedido -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    app:cardBackgroundColor="#F7F9FA"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Número de pedido"
                            android:textColor="@color/gunmetal"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOrderNumberBadge"
                            android:layout_width="54dp"
                            android:layout_height="48dp"
                            android:background="@drawable/sh_order_number_badge"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="76" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Datos de Recogida -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="140dp"
                        android:layout_height="wrap_content"
                        android:text="Hora de recogida"
                        android:textColor="@color/gunmetal"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTrackingTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/gunmetal"
                        android:textSize="13sp"
                        tools:text="8:00 AM" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="140dp"
                        android:layout_height="wrap_content"
                        android:text="Lugar de recogida"
                        android:textColor="@color/gunmetal"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTrackingCafe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/police_blue"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="Cavosh Cafe" />

                        <TextView
                            android:id="@+id/tvTrackingAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Legnicka 20, Wrocław"
                            android:textColor="#757575"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Sección: Seguimiento del pedido -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Seguimiento del pedido"
                    android:textColor="@color/gunmetal"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Timeline de Seguimiento con 3 estados -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <!-- Barra vertical de progreso -->
                    <LinearLayout
                        android:layout_width="32dp"
                        android:layout_height="140dp"
                        android:background="@drawable/sh_edittext_city"
                        android:orientation="vertical">

                        <!-- Paso 1 activo -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/sh_btn_gunmetal" />
                    </LinearLayout>

                    <!-- Lista de Estados -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <!-- Estado 1: Pedido realizado -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Pedido realizado"
                                android:textColor="@color/gunmetal"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_check_orange" />
                        </LinearLayout>

                        <!-- Estado 2: Preparando -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Preparando"
                                android:textColor="#88A0B2"
                                android:textSize="14sp" />

                            <View
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:background="@drawable/sh_edittext_city" />
                        </LinearLayout>

                        <!-- Estado 3: ¡Pedido listo! -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="¡Pedido listo!"
                                android:textColor="#B0BEC5"
                                android:textSize="14sp" />

                            <View
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:background="@drawable/sh_edittext_city" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

                <!-- Botón Volver al Inicio -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackHome"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="26dp"
                    android:backgroundTint="@color/gunmetal"
                    android:text="Volver al Inicio"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="24dp"
                    app:elevation="2dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
