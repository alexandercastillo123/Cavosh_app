<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Contenedor imagen café -->
        <FrameLayout
            android:id="@+id/flCartImage"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:background="@drawable/sh_image_container"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivCartProduct"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_img_cafe" />
        </FrameLayout>

        <!-- Nombre del Producto -->
        <TextView
            android:id="@+id/tvCartProductName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/gunmetal"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/stepperCart"
            app:layout_constraintStart_toEndOf="@id/flCartImage"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Caramel Macchiato" />

        <!-- Opciones / Personalización -->
        <TextView
            android:id="@+id/tvCartProductOptions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:textColor="#757575"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/stepperCart"
            app:layout_constraintStart_toEndOf="@id/flCartImage"
            app:layout_constraintTop_toBottomOf="@id/tvCartProductName"
            tools:text="Pequeño, Leche de avena" />

        <!-- Precio -->
        <TextView
            android:id="@+id/tvCartProductPrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/gunmetal"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/stepperCart"
            app:layout_constraintStart_toEndOf="@id/flCartImage"
            app:layout_constraintTop_toBottomOf="@id/tvCartProductOptions"
            tools:text="$9.40" />

        <!-- Stepper vertical naranja (+ cantidad -) -->
        <LinearLayout
            android:id="@+id/stepperCart"
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:background="@drawable/sh_btn_carmine_pink"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/btnCartPlus"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCartQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCartMinus"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="-"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
